#!/usr/bin/env bash
#MISE description="Show the branch and number of changed files in each clone"
#MISE quiet=true
set -euo pipefail
source "$MISE_CONFIG_ROOT/scripts/clones.sh"

# The branch is read in each repository separately: clones have their own git
# and branches, which the meta-repository does not know about.
printf '%-16s %-28s %s\n' REPO BRANCH CHANGED
while read -r dir; do
	name="$(basename "$dir")"
	if [ ! -d "$dir/.git" ]; then
		printf '%-16s %-28s %s\n' "$name" missing -
		continue
	fi
	branch="$(git -C "$dir" branch --show-current)"
	changed="$(git -C "$dir" status --short | wc -l | tr -d ' ')"
	printf '%-16s %-28s %s\n' "$name" "${branch:-detached}" "$changed"
done < <(declared_clones)
