#!/usr/bin/env bash
#MISE description="Run the meta-repository tests from tests/, each file in a temporary folder"
#USAGE arg "[files]" var=#true help="Test files, all tests/*.sh by default"
set -euo pipefail

# Each test file gets its own temporary folder in TEST_TMP, removed after the
# file finishes. Shared helpers live in tests/lib.sh.
files=()
if [ -n "${usage_files:-}" ]; then
	eval "files=(${usage_files})"
else
	for f in tests/*.sh; do
		[ "$(basename "$f")" = lib.sh ] && continue
		files+=("$f")
	done
fi

failed=()
for f in "${files[@]}"; do
	echo "== $f"
	tmp="$(mktemp -d)"
	if ! TEST_TMP="$tmp" META_ROOT="$PWD" bash "$f"; then
		failed+=("$f")
	fi
	rm -rf "$tmp"
done

if [ "${#failed[@]}" -gt 0 ]; then
	echo
	echo "Failed test files:"
	printf '  %s\n' "${failed[@]}"
	exit 1
fi
echo
echo "All test files passed: ${#files[@]}"
